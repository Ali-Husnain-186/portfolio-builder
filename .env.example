# All optional — the app runs with zero configuration.

# Storage driver: blobs (default on Netlify) | postgres | file (default locally)
# DB_DRIVER=
# Set to use Postgres (Supabase, Neon, …). Auto-selects the postgres driver.
# DATABASE_URL=postgresql://user:pass@host:5432/db
# DATABASE_SSL=true

# Comma-separated emails that get the Admin panel
ADMIN_EMAILS=

# Public base URL used for share links (defaults to the current domain)
# NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Seed 3 public demo portfolios on first run (set to false to disable)
# SEED_DEMO=true
